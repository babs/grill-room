{
  "realm": "grill-room",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "grill-members" },
    { "name": "grill-admins" }
  ],
  "clients": [
    {
      "clientId": "grill-room-e2e",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "e2e-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${GRILL_ROOM_E2E_URL}/auth/callback"],
      "webOrigins": ["${GRILL_ROOM_E2E_URL}"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "6f1c0a52-0001-4000-8000-000000000001",
      "username": "mia",
      "firstName": "Mia",
      "lastName": "Member",
      "email": "mia@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "mia-e2e-password", "temporary": false }],
      "groups": ["/grill-members"]
    },
    {
      "id": "6f1c0a52-0002-4000-8000-000000000002",
      "username": "ada",
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "ada@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "ada-e2e-password", "temporary": false }],
      "groups": ["/grill-members", "/grill-admins"]
    },
    {
      "id": "6f1c0a52-0003-4000-8000-000000000003",
      "username": "otto",
      "firstName": "Otto",
      "lastName": "Outsider",
      "email": "otto@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "otto-e2e-password", "temporary": false }]
