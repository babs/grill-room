    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "paths": {
