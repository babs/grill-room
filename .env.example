# Copy to .env (untracked) and fill in.
# Domain served by the local traefik with a wildcard certificate; the app answers on grill-room.<DEV_DOMAIN>.
DEV_DOMAIN=local.example.com
# The local traefik's file-provider rules directory (watched).
TRAEFIK_RULES_DIR=/path/to/traefik/rules
GRILL_ROOM_PORT=7680
GRILL_ROOM_METRICS_PORT=7681
# Host address the app port is published on; `make dev-up` defaults it to the docker bridge gateway.
# GRILL_ROOM_BIND=
# LiveKit API key pair, shared by LiveKit, the room server and the STT worker.
# LIVEKIT_API_KEY=API$(openssl rand -hex 6)    LIVEKIT_API_SECRET=$(openssl rand -hex 32)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Service token the STT worker presents to the room server: openssl rand -hex 24
STT_TOKEN=
# Pins the admin token (the voice e2e tests need it): openssl rand -hex 24
GRILL_ROOM_ADMIN_TOKEN=
# Host port (loopback) for the STT worker's /healthz and /metrics.
# STT_METRICS_PORT=7682
# Registry `make sandbox-push` pushes the sandbox image to, as <registry>/grill-room/sandbox:<version>.
# REGISTRY=registry.example.com
# Digest-pinned sandbox image the room server advertises to daemons; `make sandbox-push` prints it.
# Empty: each daemon builds the sandbox image from the Dockerfile it embeds.
# GRILL_ROOM_SANDBOX_IMAGE=registry.example.com/grill-room/sandbox:v0.0.0@sha256:<64 hex>
# Lab deployment (deploy/k8s/, make k8s-*). Hosts: grill-room, grill-room-livekit and grill-room-turn
# under K8S_DOMAIN; traefik must hold a certificate for them.
# K8S_DOMAIN=lab.example.com
# ReadWriteOnce StorageClass for the room server's SQLite volume.
# K8S_STORAGE_CLASS=
# Digest-pinned images; `make k8s-push` prints both lines.
# GRILL_ROOM_IMAGE=registry.example.com/grill-room/server:v0.0.0@sha256:<64 hex>
# GRILL_STT_IMAGE=registry.example.com/grill-room/stt:v0.0.0@sha256:<64 hex>
