+/// A Teams meeting as the join URL names it.
+#[derive(Debug, PartialEq)]
+pub(crate) struct MeetingTarget {
+    pub(crate) thread_id: String,
+    pub(crate) message_id: String,
+    pub(crate) organizer_oid: String,
+    pub(crate) tenant_id: String,
+}
+
+fn percent_decode(s: &str) -> String {
+    let b = s.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == b'%' && i + 2 < b.len() {
+            let hex = std::str::from_utf8(&b[i + 1..i + 3]).unwrap_or("");
+            if let Ok(v) = u8::from_str_radix(hex, 16) {
+                out.push(v);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(b[i]);
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// Parses a `.../l/meetup-join/<thread>/<messageId>?context={"Tid":..,"Oid":..}` link, wherever it
+/// is embedded (plain, `/v2/?meetingjoin=true#/l/meetup-join/...`, or a Safe Links wrapper).
+pub(crate) fn parse_meeting_url(url: &str) -> Result<MeetingTarget> {
+    // Safe Links and the v2 client wrap the real link: decode until the marker shows up.
+    let mut text = url.to_string();
+    for _ in 0..3 {
+        if text.contains("meetup-join/") {
+            break;
+        }
+        text = percent_decode(&text);
+    }
+    let start = text.find("meetup-join/").with_context(|| {
+        "Not a meetup-join link. Short /meet/<id> links are not handled: in Teams use \
+         'Copy join info' or open the invite and copy the long link"
+    })?;
+    let rest = &text[start + "meetup-join/".len()..];
+    let (path, query) = rest.split_once('?').unwrap_or((rest, ""));
+    let mut parts = path.splitn(3, '/');
+    let thread_id = percent_decode(parts.next().unwrap_or_default());
+    let message_id = parts.next().filter(|m| !m.is_empty()).unwrap_or("0").to_string();
+    anyhow::ensure!(
+        thread_id.starts_with("19:") && thread_id.contains('@'),
+        "Unexpected meeting thread id: {}",
+        thread_id
+    );
+    let context = query
+        .split('&')
+        .find_map(|kv| kv.strip_prefix("context="))
+        .map(percent_decode)
+        .context("Join link has no context= parameter (organizer and tenant)")?;
+    let v: serde_json::Value =
+        serde_json::from_str(&context).context("Join link context is not JSON")?;
+    let field = |k: &str| {
+        v.get(k)
+            .and_then(|x| x.as_str())
+            .map(String::from)
+            .with_context(|| format!("Join link context has no {}", k))
+    };
+    Ok(MeetingTarget {
+        thread_id,
+        message_id,
+        organizer_oid: field("Oid")?,
+        tenant_id: field("Tid")?,
+    })
+}
