+/// Prints calendar events with a Teams join link, from 2 h ago to 24 h ahead (Graph calendarView):
+/// invites often show the short /meet/<id> form, while `onlineMeeting.joinUrl` may hold the long one.
+pub async fn list_meetings() -> Result<()> {
+    let config = Config::load().context("Failed to load config")?;
+    let token = config
+        .get_graph_token()
+        .filter(|t| !t.is_expired())
+        .context("No valid Graph token: run login again")?;
+    let now = chrono::Utc::now();
+    let url = format!(
+        "https://graph.microsoft.com/v1.0/me/calendar/calendarView?startDateTime={}&endDateTime={}\
+         &$top=50&$orderby=start/dateTime&$select=subject,start,onlineMeeting",
+        (now - chrono::Duration::hours(2)).format("%Y-%m-%dT%H:%M:%SZ"),
+        (now + chrono::Duration::hours(24)).format("%Y-%m-%dT%H:%M:%SZ"),
+    );
+    let resp = reqwest::Client::new()
+        .get(&url)
+        .bearer_auth(&token.token)
+        .header("Prefer", "outlook.timezone=\"UTC\"")
+        .send()
+        .await
+        .context("Graph calendarView request failed")?;
+    let status = resp.status();
+    let body: serde_json::Value = resp.json().await.unwrap_or_default();
+    anyhow::ensure!(status.is_success(), "Graph calendarView returned {}: {}", status, body);
+    let http = reqwest::Client::new();
+    for ev in body["value"].as_array().into_iter().flatten() {
+        let Some(join) = ev.pointer("/onlineMeeting/joinUrl").and_then(|u| u.as_str()) else {
+            continue;
+        };
+        let start = ev.pointer("/start/dateTime").and_then(|v| v.as_str()).unwrap_or("?");
+        let subject = ev["subject"].as_str().unwrap_or("(no subject)");
+        println!("{} UTC  {}\n  {}", &start[..start.len().min(16)], subject, join);
+        if !join.contains("meetup-join") {
+            match long_join_url(&http, &token.token, join).await {
+                Ok(long) => println!("  long form: {}", long),
+                Err(e) => println!("  no long form: {:#}", e),
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Builds the meetup-join form of a short /meet/<id> link from Graph's onlineMeeting record.
+async fn long_join_url(http: &reqwest::Client, graph_token: &str, short: &str) -> Result<String> {
+    let filter = format!("JoinWebUrl eq '{}'", short.replace('\'', "''"));
+    let resp = http
+        .get("https://graph.microsoft.com/v1.0/me/onlineMeetings")
+        .query(&[("$filter", filter.as_str())])
+        .bearer_auth(graph_token)
+        .send()
+        .await
+        .context("Graph onlineMeetings request failed")?;
+    let status = resp.status();
+    let body: serde_json::Value = resp.json().await.unwrap_or_default();
+    anyhow::ensure!(status.is_success(), "Graph onlineMeetings returned {}", status);
+    let m = body.pointer("/value/0").context("Graph knows no meeting for this link")?;
+    let field = |ptr: &str| {
+        m.pointer(ptr)
+            .and_then(|v| v.as_str())
+            .map(String::from)
+            .with_context(|| format!("onlineMeeting has no {}", ptr))
+    };
+    let thread = field("/chatInfo/threadId")?;
+    let message = field("/chatInfo/messageId").unwrap_or_else(|_| "0".into());
+    let oid = field("/participants/organizer/identity/user/id")?;
+    let tid = field("/participants/organizer/identity/user/tenantId")?;
+    Ok(meetup_join_url(&MeetingTarget {
+        thread_id: thread,
+        message_id: message,
+        organizer_oid: oid,
+        tenant_id: tid,
+    }))
+}
+
+/// The meetup-join link the Teams clients build for a meeting, the form `parse_meeting_url` reads.
+fn meetup_join_url(m: &MeetingTarget) -> String {
+    let enc = |s: &str| -> String {
+        s.bytes()
+            .map(|b| match b {
+                b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' => (b as char).to_string(),
+                _ => format!("%{:02x}", b),
+            })
+            .collect()
+    };
+    let context = format!(r#"{{"Tid":"{}","Oid":"{}"}}"#, m.tenant_id, m.organizer_oid);
+    format!(
+        "https://teams.microsoft.com/l/meetup-join/{}/{}?context={}",
+        enc(&m.thread_id),
+        enc(&m.message_id),
+        enc(&context)
+    )
+}
