diff --git a/src/calling/capture.rs b/src/calling/capture.rs
new file mode 100644
index 0000000..060e67f
--- /dev/null
+++ b/src/calling/capture.rs
@@ -0,0 +1,209 @@
+//! S18 capture: writes everything a meeting call receives, for offline analysis.
+//!
+//! Files in the capture directory:
+//! - `rtp.jsonl`: one row per decrypted RTP packet (ssrc, seq, ts, pt, marker, CSRC list,
+//!   header extension), `plen` bytes of payload appended to `ssrc-<ssrc>.pay` in arrival order;
+//! - `rtcp.jsonl`: every decrypted RTCP compound packet in hex (DSH lives there, MS-RTP 2.2.12.3);
+//! - `trouter.jsonl`: every Trouter frame with its callback URL and decoded body (roster, csrcInfo,
+//!   dominantSpeakerInfo);
+//! - `<name>.sdp` / `<name>.json`: the offer, the answer and the call setup responses.
+
+use std::collections::HashMap;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+pub struct Capture {
+    dir: PathBuf,
+    start: Instant,
+    rtp: Mutex<BufWriter<File>>,
+    rtcp: Mutex<BufWriter<File>>,
+    trouter: Mutex<BufWriter<File>>,
+    /// None marks an SSRC whose payload file could not be created: warned once, then skipped.
+    payloads: Mutex<HashMap<u32, Option<BufWriter<File>>>>,
+}
+
+static CAPTURE: OnceLock<Capture> = OnceLock::new();
+
+/// Turns capture on for the whole process; later calls are ignored.
+pub fn init(dir: &str) -> anyhow::Result<()> {
+    let dir = PathBuf::from(dir);
+    std::fs::create_dir_all(&dir)?;
+    let open = |name: &str| -> anyhow::Result<Mutex<BufWriter<File>>> {
+        Ok(Mutex::new(BufWriter::new(File::create(dir.join(name))?)))
+    };
+    let cap = Capture {
+        rtp: open("rtp.jsonl")?,
+        rtcp: open("rtcp.jsonl")?,
+        trouter: open("trouter.jsonl")?,
+        payloads: Mutex::new(HashMap::new()),
+        start: Instant::now(),
+        dir,
+    };
+    let _ = CAPTURE.set(cap);
+    Ok(())
+}
+
+pub fn get() -> Option<&'static Capture> {
+    CAPTURE.get()
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{:02x}", x)).collect()
+}
+
+impl Capture {
+    fn t_ms(&self) -> u128 {
+        self.start.elapsed().as_millis()
+    }
+
+    /// Writes a whole file in the capture directory (SDP, setup responses).
+    pub fn file(&self, name: &str, content: &str) {
+        if let Err(e) = std::fs::write(self.dir.join(name), content) {
+            tracing::warn!("capture: cannot write {}: {:#}", name, e);
+        }
+    }
+
+    /// Records one decrypted RTP packet. Parses the header itself: `rtp::decode` drops the CSRC values.
+    pub fn rtp(&self, pkt: &[u8]) {
+        if pkt.len() < 12 {
+            return;
+        }
+        let cc = (pkt[0] & 0x0F) as usize;
+        let has_ext = pkt[0] & 0x10 != 0;
+        let mut off = 12 + cc * 4;
+        if pkt.len() < off {
+            return;
+        }
+        let csrc: Vec<u32> = (0..cc)
+            .map(|i| u32::from_be_bytes(pkt[12 + i * 4..16 + i * 4].try_into().unwrap()))
+            .collect();
+        let (mut ext_profile, mut ext_hex) = (None, String::new());
+        if has_ext && pkt.len() >= off + 4 {
+            let words = u16::from_be_bytes([pkt[off + 2], pkt[off + 3]]) as usize;
+            ext_profile = Some(u16::from_be_bytes([pkt[off], pkt[off + 1]]));
+            let end = (off + 4 + words * 4).min(pkt.len());
+            ext_hex = hex(&pkt[off + 4..end]);
+            off = end;
+        }
+        // Padding (RFC 3550 5.1): the last byte counts the padding bytes.
+        let mut end = pkt.len();
+        if pkt[0] & 0x20 != 0 {
+            end = end.saturating_sub(pkt[end - 1] as usize).max(off);
+        }
+        let payload = &pkt[off..end];
+        let ssrc = u32::from_be_bytes([pkt[8], pkt[9], pkt[10], pkt[11]]);
+        let row = serde_json::json!({
+            "t": self.t_ms(),
+            "ssrc": ssrc,
+            "seq": u16::from_be_bytes([pkt[2], pkt[3]]),
+            "ts": u32::from_be_bytes([pkt[4], pkt[5], pkt[6], pkt[7]]),
+            "pt": pkt[1] & 0x7F,
+            "m": pkt[1] & 0x80 != 0,
+            "csrc": csrc,
+            "ext_profile": ext_profile,
+            "ext": ext_hex,
+            "plen": payload.len(),
+        });
+        if let Ok(mut w) = self.rtp.lock() {
+            let _ = writeln!(w, "{}", row);
+        }
+        if let Ok(mut map) = self.payloads.lock() {
+            let w = map.entry(ssrc).or_insert_with(|| {
+                File::create(self.dir.join(format!("ssrc-{}.pay", ssrc)))
+                    .map(BufWriter::new)
+                    .map_err(|e| tracing::warn!("capture: cannot store SSRC {} payloads: {:#}", ssrc, e))
+                    .ok()
+            });
+            if let Some(w) = w {
+                let _ = w.write_all(payload);
+            }
+        }
+    }
+
+    pub fn rtcp(&self, leg: &str, data: &[u8]) {
+        let row = serde_json::json!({
+            "t": self.t_ms(),
+            "leg": leg,
+            "pt": data.get(1).copied().unwrap_or(0),
+            "fmt": data.first().map(|b| b & 0x1F).unwrap_or(0),
+            "hex": hex(data),
+        });
+        if let Ok(mut w) = self.rtcp.lock() {
+            let _ = writeln!(w, "{}", row);
+        }
+    }
+
+    /// Records one Trouter frame, flushed at once: low volume, and the call setup is what we debug.
+    pub fn trouter(&self, frame: &str) {
+        if frame.starts_with("2::") || frame.starts_with("1::") {
+            return;
+        }
+        let url = frame
+            .find(":::")
+            .and_then(|i| serde_json::from_str::<serde_json::Value>(&frame[i + 3..]).ok())
+            .and_then(|v| v.get("url").and_then(|u| u.as_str()).map(String::from));
+        let body = crate::calling::call_test::extract_call_payload(frame);
+        let row = serde_json::json!({
+            "t": self.t_ms(),
+            "path": url,
+            "body": body,
+            "raw": if body.is_none() { frame.chars().take(4000).collect::<String>() } else { String::new() },
+        });
+        if let Ok(mut w) = self.trouter.lock() {
+            let _ = writeln!(w, "{}", row);
+            let _ = w.flush();
+        }
+    }
+
+    pub fn flush(&self) {
+        for w in [&self.rtp, &self.rtcp, &self.trouter] {
+            if let Ok(mut w) = w.lock() {
+                let _ = w.flush();
+            }
+        }
+        if let Ok(mut map) = self.payloads.lock() {
+            for w in map.values_mut().flatten() {
+                let _ = w.flush();
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rtp_row_keeps_csrcs_extension_and_strips_padding() {
+        let dir = std::env::temp_dir().join(format!("s18-capture-{}", std::process::id()));
+        init(dir.to_str().unwrap()).unwrap();
+        let cap = get().unwrap();
+        // V=2, P=1, X=1, CC=2 | M=1, PT=0 | seq 7 | ts 320 | ssrc 0x0a0b0c0d
+        let mut pkt = vec![0xB2, 0x80, 0x00, 0x07, 0, 0, 0x01, 0x40, 0x0a, 0x0b, 0x0c, 0x0d];
+        pkt.extend_from_slice(&2886u32.to_be_bytes());
+        pkt.extend_from_slice(&2890u32.to_be_bytes());
+        pkt.extend_from_slice(&[0xBE, 0xDE, 0x00, 0x01, 0x10, 0x7f, 0x00, 0x00]);
+        pkt.extend_from_slice(&[0x11, 0x22, 0x33]);
+        pkt.extend_from_slice(&[0x00, 0x02]); // 2 padding bytes
+        cap.rtp(&pkt);
+        cap.flush();
+        let row: serde_json::Value = serde_json::from_str(
+            std::fs::read_to_string(dir.join("rtp.jsonl")).unwrap().lines().next().unwrap(),
+        )
+        .unwrap();
+        assert_eq!(row["ssrc"], 0x0a0b0c0d);
+        assert_eq!(row["seq"], 7);
+        assert_eq!(row["ts"], 320);
+        assert_eq!(row["m"], true);
+        assert_eq!(row["csrc"], serde_json::json!([2886, 2890]));
+        assert_eq!(row["ext_profile"], 0xBEDE);
+        assert_eq!(row["ext"], "107f0000");
+        assert_eq!(row["plen"], 3);
+        let pay = std::fs::read(dir.join(format!("ssrc-{}.pay", 0x0a0b0c0d))).unwrap();
+        assert_eq!(pay, vec![0x11, 0x22, 0x33]);
+        std::fs::remove_dir_all(dir).ok();
+    }
+}
