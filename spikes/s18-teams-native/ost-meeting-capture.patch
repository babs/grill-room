+/// Keeps the call up for `duration` or until Ctrl-C / the server ends it, while serving Trouter:
+/// heartbeats, delivery acks (in `recv_frame`), late `callAcceptance` acknowledgements, and the
+/// capture of every frame (roster, csrcInfo, dominantSpeakerInfo).
+async fn stay_in_call(
+    http: &reqwest::Client,
+    conv_params: &signaling::ConversationCallParams<'_>,
+    mut ws: Option<&mut websocket::TrouterSocket>,
+    duration: Duration,
+) {
+    let stop = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    {
+        let stop = stop.clone();
+        tokio::spawn(async move {
+            if tokio::signal::ctrl_c().await.is_ok() {
+                stop.store(true, std::sync::atomic::Ordering::SeqCst);
+                eprintln!("Hanging up; Ctrl-C again to quit at once");
+            }
+            if tokio::signal::ctrl_c().await.is_ok() {
+                if let Some(cap) = super::capture::get() {
+                    cap.flush();
+                }
+                std::process::exit(130);
+            }
+        });
+    }
+    let deadline = tokio::time::Instant::now() + duration;
+    let mut last_heartbeat = tokio::time::Instant::now();
+    let mut last_flush = tokio::time::Instant::now();
+    while tokio::time::Instant::now() < deadline {
+        if stop.load(std::sync::atomic::Ordering::SeqCst) {
+            println!("stopped_by=ctrl-c");
+            break;
+        }
+        if last_flush.elapsed() >= Duration::from_secs(2) {
+            if let Some(cap) = super::capture::get() {
+                cap.flush();
+            }
+            last_flush = tokio::time::Instant::now();
+        }
+        let Some(sock) = ws.as_deref_mut() else {
+            tokio::time::sleep(Duration::from_millis(500)).await;
+            continue;
+        };
+        if last_heartbeat.elapsed() >= Duration::from_secs(30) {
+            sock.send_text("2::").await.ok();
+            last_heartbeat = tokio::time::Instant::now();
+        }
+        // ponytail: a timeout around recv_frame can cancel it while it sends a delivery ack, a rare
+        // lost ack; a task owning the socket fixes it if the live run shows 430/10065 drops.
+        let frame = match tokio::time::timeout(Duration::from_secs(2), sock.recv_frame()).await {
+            Err(_) => continue,
+            Ok(Ok(Some(f))) => f,
+            Ok(Ok(None)) | Ok(Err(_)) => {
+                tracing::warn!("Trouter closed during the call: no more roster or speaker events");
+                ws = None;
+                continue;
+            }
+        };
+        if frame.starts_with("2::") {
+            sock.send_text("2::").await.ok();
+            continue;
+        }
+        let Some(v) = extract_call_payload(&frame) else { continue };
+        if let Some(reason) = check_call_end(&v) {
+            println!("call_ended={}", reason);
+            break;
+        }
+        // The controller resends callAcceptance until acknowledged, then drops the call (408/10056).
+        if let Some(url) = v.pointer("/callAcceptance/links/acknowledgement").and_then(|u| u.as_str()) {
+            if let Err(e) = signaling::acknowledge_call_acceptance(http, url, conv_params).await {
+                tracing::warn!("Late acceptance acknowledgement failed: {:#}", e);
+            }
+        }
+    }
+}
